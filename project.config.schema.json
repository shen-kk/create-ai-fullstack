{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adminback-template.local/project.config.schema.json",
  "title": "Adminback project configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "template",
    "project",
    "runtime",
    "database",
    "localization",
    "ui",
    "features",
    "modules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "template": {
      "type": "object",
      "required": ["name", "version", "repository"],
      "properties": {
        "name": { "const": "adminback-template" },
        "version": { "type": "string" },
        "repository": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["name", "packageScope", "displayName", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "packageScope": { "type": "string", "pattern": "^@[a-z][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["packageManager", "adminPort", "apiPort", "webPort"],
      "properties": {
        "packageManager": { "const": "pnpm" },
        "adminPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "apiPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "webPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["mode", "engine", "orm"],
      "properties": {
        "mode": { "enum": ["memory", "prisma"] },
        "engine": { "enum": ["none", "postgresql"] },
        "orm": { "enum": ["none", "prisma"] }
      },
      "additionalProperties": false
    },
    "localization": {
      "type": "object",
      "required": ["defaultLocale", "supportedLocales"],
      "properties": {
        "defaultLocale": { "enum": ["zh-CN"] },
        "supportedLocales": {
          "type": "array",
          "items": { "enum": ["zh-CN"] },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": ["web"],
      "properties": {
        "web": {
          "type": "object",
          "required": ["businessComponents", "motion", "orchestration", "designStandard"],
          "properties": {
            "businessComponents": { "const": "shadcn-vue" },
            "motion": { "const": "vueuse-motion" },
            "orchestration": { "const": "gsap" },
            "designStandard": { "const": "apple-linear-vercel" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "items": {
        "enum": ["customerWeb"]
      },
      "uniqueItems": true
    },
    "modules": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "providers": {
      "type": "object",
      "properties": {
        "objectStorage": {
          "enum": ["none", "resource_library"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
