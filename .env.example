NODE_ENV=development
ADMIN_PORT=3000
API_PORT=3001
WEB_PORT=3002
# 由 pnpm setup 生成；模板源仓库不预设或连接任何数据库
DATABASE_URL=
# memory 便于零依赖预览；接入 PostgreSQL 并执行迁移/种子后改为 prisma
# 浏览器统一使用同源 /api；开发环境由 Vite/Nuxt 代理，生产环境由 Nginx 等反向代理。
PUBLIC_API_BASE_URL=/api
ADMIN_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3002
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
# 可选：用户端独立签名密钥；未设置时开发环境回退到上面两项
CUSTOMER_JWT_ACCESS_SECRET=replace-with-customer-access-secret-at-least-32-characters
CUSTOMER_JWT_REFRESH_SECRET=replace-with-customer-refresh-secret-at-least-32-characters
# 生产环境必须替换，用于 AES-256-GCM 加密服务配置中的密钥
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-config-encryption-key
DEPLOY_WORKER_ENABLED=true
# Worker 租约与心跳；租约不得低于 15 秒，默认 30 秒
DEPLOY_WORKER_LEASE_MS=30000
# 单条远程命令最大执行时间，默认 30 分钟
DEPLOY_WORKER_COMMAND_TIMEOUT_MS=1800000
# 远端安装/构建子进程的 Node 堆内存上限，默认 768 MB
DEPLOY_BUILD_MAX_OLD_SPACE_MB=768
# 发布开始前要求的可用内存（MemAvailable + SwapFree），默认 1536 MB
DEPLOY_MIN_AVAILABLE_MEMORY_MB=1536
# 仅用于兼容没有租约字段的旧运行任务，默认 2 小时
DEPLOY_WORKER_STALE_TIMEOUT_MS=7200000
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PHONE=replace-with-an-11-digit-mobile-number
DEV_ADMIN_NAME=模板管理员
DEV_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-6-characters
# 仅 docker-compose.production.yml 使用；生产值由部署平台安全提供
POSTGRES_DB=template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
