NODE_ENV=development
ADMIN_PORT=3000
API_PORT=3001
WEB_PORT=3002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template?schema=public
# memory 便于零依赖预览；接入 PostgreSQL 并执行迁移/种子后改为 prisma
DATA_SOURCE=memory
PUBLIC_API_BASE_URL=http://localhost:3001/api
ADMIN_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3002
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
# 可选：用户端独立签名密钥；未设置时开发环境回退到上面两项
CUSTOMER_JWT_ACCESS_SECRET=replace-with-customer-access-secret-at-least-32-characters
CUSTOMER_JWT_REFRESH_SECRET=replace-with-customer-refresh-secret-at-least-32-characters
# 生产环境必须替换，用于 AES-256-GCM 加密服务配置中的密钥
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-config-encryption-key
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PHONE=13800000000
DEV_ADMIN_NAME=模板管理员
DEV_ADMIN_PASSWORD=Admin@123456
# 仅 docker-compose.production.yml 使用；生产值由部署平台安全提供
POSTGRES_DB=template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
