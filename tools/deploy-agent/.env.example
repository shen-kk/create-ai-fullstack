# Deploy Agent 运行配置：复制为 .env 后修改

# Agent 连接的模板 API 地址
AGENT_API_URL=https://api.example.com/api

# 与 API 的 DEPLOYMENT_CALLBACK_TOKEN 保持一致
DEPLOYMENT_CALLBACK_TOKEN=replace-with-a-long-random-token

# 当前 Agent 的唯一名称
DEPLOY_AGENT_NAME=test-server-agent

# Agent 监听地址；仅本机后台需要调用时保持 127.0.0.1
DEPLOY_AGENT_HOST=127.0.0.1
DEPLOY_AGENT_PORT=3900

# Agent 执行部署的根目录
DEPLOY_AGENT_WORKDIR=/opt/deploy-agent

# Docker Compose 文件所在目录
DEPLOY_PROJECT_DIR=/opt/apps/adminback-template

# 轮询后台任务的时间间隔（毫秒）
DEPLOY_AGENT_POLL_INTERVAL=5000

# 允许执行的应用，逗号分隔：admin,api,web
DEPLOY_AGENT_APPLICATIONS=admin,api,web
